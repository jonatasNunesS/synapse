# Hoist jsdom para o node_modules raiz — o vitest (sob pnpm) precisa resolvê-lo
# para o environment jsdom dos testes de componente. Mantém também os padrões
# do pnpm (eslint/prettier) para não quebrar a resolução dessas ferramentas.
public-hoist-pattern[]=*jsdom*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
